# go-sports-league 环境变量样例
# 复制为 .env 后按需修改

# ---------- 数据库 (MySQL 8.0.46) ----------
APP_MYSQL_HOST=mysql
APP_MYSQL_PORT=3306
APP_MYSQL_USER=league_user
APP_MYSQL_PASSWORD=league_pass
APP_MYSQL_DATABASE=league_db

# ---------- 缓存 (Redis 7.4.10) ----------
APP_REDIS_HOST=redis
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

# ---------- JWT ----------
APP_JWT_SECRET=change-me-in-production-please-use-long-random-string
APP_JWT_ACCESS_TOKEN_TTL=15m
APP_JWT_REFRESH_TOKEN_TTL=168h
APP_JWT_ISSUER=go-sports-league

# ---------- 默认管理员 ----------
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=Admin123!
APP_ADMIN_EMAIL=admin@league.local

# ---------- 服务 ----------
APP_SERVER_PORT=8080
APP_LOGGING_LEVEL=info
APP_LOGGING_FORMAT=json

# ---------- 限流 ----------
APP_RATE_LIMIT_LOGIN_PER_MINUTE_IP=5
APP_RATE_LIMIT_LOGIN_PER_MINUTE_USER=10
APP_RATE_LIMIT_GLOBAL_PER_MINUTE=600
